<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="tpl_any_msa" model="wa.gulf.template">
        <field name="name">General greeting (formal)</field>
        <field name="key">any</field>
        <field name="style">msa</field>
        <field name="sequence">90</field>
        <field name="body">السلام عليكم ورحمة الله {العميل}،
نتواصل معكم من {الشركة} بخصوص {المستند}.
{الرابط}

مع خالص التحية،
{الموظف}</field>
    </record>
    <record id="tpl_any_gulf" model="wa.gulf.template">
        <field name="name">General greeting (Gulf)</field>
        <field name="key">any</field>
        <field name="style">gulf</field>
        <field name="sequence">91</field>
        <field name="body">هلا والله {العميل} 👋
معك {الموظف} من {الشركة}، بخصوص {المستند}.
{الرابط}

بخدمتك دايمًا 🌷</field>
    </record>
    <record id="tpl_any_en" model="wa.gulf.template">
        <field name="name">General greeting (English)</field>
        <field name="key">any</field>
        <field name="style">en</field>
        <field name="sequence">92</field>
        <field name="body">Hello {partner},
This is {user} from {company} regarding {doc}.
{link}

Best regards,
{company}</field>
    </record>
