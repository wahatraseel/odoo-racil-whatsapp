<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="doc_account_move" model="wa.gulf.document">
        <field name="name">Invoices &amp; Credit Notes</field>
        <field name="model_name">account.move</field>
        <field name="sequence">1</field>
    </record>
    <record id="doc_sale_order" model="wa.gulf.document">
        <field name="name">Quotations &amp; Sales Orders</field>
        <field name="model_name">sale.order</field>
        <field name="sequence">2</field>
    </record>
    <record id="doc_res_partner" model="wa.gulf.document">
        <field name="name">Contacts</field>
        <field name="model_name">res.partner</field>
        <field name="partner_field"></field>
        <field name="sequence">3</field>
    </record>
    <record id="doc_purchase_order" model="wa.gulf.document">
        <field name="name">Purchase Orders</field>
        <field name="model_name">purchase.order</field>
        <field name="sequence">4</field>
    </record>
    <record id="doc_stock_picking" model="wa.gulf.document">
        <field name="name">Deliveries &amp; Receipts</field>
        <field name="model_name">stock.picking</field>
        <field name="sequence">5</field>
    </record>
    <record id="doc_crm_lead" model="wa.gulf.document">
        <field name="name">CRM Leads &amp; Opportunities</field>
        <field name="model_name">crm.lead</field>
        <field name="phone_field">phone</field>
        <field name="sequence">6</field>
    </record>
    <record id="doc_pos_order" model="wa.gulf.document">
        <field name="name">Point of Sale Orders</field>
        <field name="model_name">pos.order</field>
        <field name="sequence">7</field>
        <field name="active" eval="False"/>
    </record>
    <record id="doc_project_task" model="wa.gulf.document">
        <field name="name">Project Tasks</field>
        <field name="model_name">project.task</field>
        <field name="sequence">8</field>
        <field name="active" eval="False"/>
    </record>
    <record id="doc_repair_order" model="wa.gulf.document">
        <field name="name">Repair Orders</field>
        <field name="model_name">repair.order</field>
        <field name="sequence">9</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
