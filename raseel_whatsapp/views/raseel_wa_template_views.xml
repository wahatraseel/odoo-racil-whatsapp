<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="raseel_wa_template_view_list" model="ir.ui.view">
        <field name="name">raseel.wa.template.list</field>
        <field name="model">raseel.wa.template</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="key"/>
                <field name="style"/>
                <field name="model_name" optional="show"/>
                <field name="user_id" optional="show" widget="many2one_avatar_user"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="raseel_wa_template_view_form" model="ir.ui.view">
        <field name="name">raseel.wa.template.form</field>
        <field name="model">raseel.wa.template</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Template">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Invoice ready"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="key"/>
                            <field name="style"/>
                        </group>
                        <group>
                            <field name="model_name" placeholder="account.move"/>
                            <field name="user_id" placeholder="Shared with everyone" groups="base.group_system"/>
                            <field name="user_id" readonly="1" force_save="1" groups="!base.group_system"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="body" class="o_raseel_wa_body" dir="auto"/>
                    <div class="alert alert-light mt-3 small" role="status">
                        <b>Placeholders</b><br/>
                        {partner} {company} {doc} {amount} {residual} {due_date} {date} {link} {user}<br/>
                        {العميل} {الشركة} {المستند} {المبلغ} {المتبقي} {الاستحقاق} {التاريخ} {الرابط} {الموظف}<br/>
                        <b>WhatsApp formatting</b>: *bold* _italic_ ~strike~
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="raseel_wa_template_view_search" model="ir.ui.view">
        <field name="name">raseel.wa.template.search</field>
        <field name="model">raseel.wa.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="body"/>
                <filter name="f_msa" string="Arabic (formal)" domain="[('style', '=', 'msa')]"/>
                <filter name="f_gulf" string="Arabic (Gulf dialect)" domain="[('style', '=', 'gulf')]"/>
                <filter name="f_en" string="English" domain="[('style', '=', 'en')]"/>
                <separator/>
                <filter name="f_mine" string="My Templates" domain="[('user_id', '=', uid)]"/>
                <filter name="f_shared" string="Shared" domain="[('user_id', '=', False)]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="g_key" string="Situation" context="{'group_by': 'key'}"/>
                <filter name="g_style" string="Language Style" context="{'group_by': 'style'}"/>
            </search>
        </field>
    </record>

    <record id="action_raseel_wa_template" model="ir.actions.act_window">
        <field name="name">WhatsApp Templates</field>
        <field name="res_model">raseel.wa.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_raseel_wa_template_mine" model="ir.actions.act_window">
        <field name="name">My Templates</field>
        <field name="res_model">raseel.wa.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'default_user_id': uid}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Write your own WhatsApp messages</p>
            <p>Personal templates are only visible to you and are picked first when they match the document.
               You can also tick "Save as my template" when sending a message.</p>
        </field>
    </record>

    <record id="raseel_wa_document_view_list" model="ir.ui.view">
        <field name="name">raseel.wa.document.list</field>
        <field name="model">raseel.wa.document</field>
        <field name="arch" type="xml">
            <list string="Documents with WhatsApp Button" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_name"/>
                <field name="partner_field" optional="show"/>
                <field name="phone_field" optional="hide"/>
                <field name="is_installed"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_raseel_wa_document" model="ir.actions.act_window">
        <field name="name">Documents with WhatsApp Button</field>
        <field name="res_model">raseel.wa.document</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a document type</p>
            <p>Any model with a customer field can get the WhatsApp button, including custom models.</p>
        </field>
    </record>

    <!-- WhatsApp application -->
    <menuitem id="menu_raseel_wa_app" name="Raseel WhatsApp" sequence="45" action="action_raseel_wa_message"
              web_icon="raseel_whatsapp,static/description/icon.png"/>
    <menuitem id="menu_raseel_wa_overdue" name="Payment Reminders" parent="menu_raseel_wa_app"
              action="action_raseel_wa_overdue" sequence="10"/>
    <menuitem id="menu_raseel_wa_reporting" name="Reporting" parent="menu_raseel_wa_app" sequence="20"/>
    <menuitem id="menu_raseel_wa_stats" name="Statistics" parent="menu_raseel_wa_reporting"
              action="action_raseel_wa_message" sequence="10"/>
    <menuitem id="menu_raseel_wa_sent" name="Sent Messages" parent="menu_raseel_wa_reporting"
              action="action_raseel_wa_message_list" sequence="20"/>
    <menuitem id="menu_raseel_wa_templates_root" name="Templates" parent="menu_raseel_wa_app" sequence="30"/>
    <menuitem id="menu_raseel_wa_template_mine" name="My Templates" parent="menu_raseel_wa_templates_root"
              action="action_raseel_wa_template_mine" sequence="10"/>
    <menuitem id="menu_raseel_wa_template" name="All Templates" parent="menu_raseel_wa_templates_root"
              action="action_raseel_wa_template" sequence="20"/>
    <menuitem id="menu_raseel_wa_root" name="Configuration" parent="menu_raseel_wa_app" sequence="90"
              groups="base.group_system"/>
    <menuitem id="menu_raseel_wa_document" name="Enabled Documents" parent="menu_raseel_wa_root"
              action="action_raseel_wa_document" sequence="20"/>
</odoo>
