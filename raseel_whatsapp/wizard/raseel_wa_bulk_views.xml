<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="raseel_wa_bulk_view_form" model="ir.ui.view">
        <field name="name">raseel.wa.bulk.form</field>
        <field name="model">raseel.wa.bulk</field>
        <field name="arch" type="xml">
            <form string="Send by WhatsApp" class="o_raseel_wa_composer o_raseel_wa_bulk">
                <field name="res_model" invisible="1"/>
                <field name="state" invisible="1"/>
                <field name="source" invisible="1"/>
                <field name="current_line_id" invisible="1"/>
                <field name="current_phone_valid" invisible="1"/>

                <!-- Step 1: settings -->
                <div invisible="state != 'setup'">
                    <div class="alert alert-info mb-3" role="status">
                        <i class="fa fa-whatsapp me-1"/>
                        <span>Every message is prepared in advance; you then open the chats one after the other
                            with a single button. No API and no automated spam, so your number stays safe.</span>
                    </div>
                    <group>
                        <group>
                            <field name="model_label" string="Documents" readonly="1"/>
                            <field name="style" widget="radio"/>
                        </group>
                        <group>
                            <field name="template_id" options="{'no_create': True, 'no_open': True}"
                                   placeholder="Automatic (best template for each document)"/>
                            <field name="link_type" widget="radio"/>
                            <field name="log_note"/>
                        </group>
                    </group>
                </div>

                <!-- Step 2: guided sending -->
                <div invisible="state == 'setup'">
                    <div class="d-flex flex-wrap gap-3 align-items-center mb-2 o_raseel_wa_counters">
                        <span class="badge rounded-pill text-bg-success">
                            <field name="sent_count" class="d-inline"/> <span>sent</span>
                        </span>
                        <span class="badge rounded-pill text-bg-primary">
                            <field name="pending_count" class="d-inline"/> <span>remaining</span>
                        </span>
                        <span class="badge rounded-pill text-bg-secondary" invisible="not skipped_count">
                            <field name="skipped_count" class="d-inline"/> <span>skipped</span>
                        </span>
                        <span class="badge rounded-pill text-bg-warning" invisible="not invalid_count">
                            <field name="invalid_count" class="d-inline"/> <span>without a valid number</span>
                        </span>
                        <field name="progress" widget="progressbar" class="flex-grow-1"/>
                    </div>
                    <div class="alert alert-success" role="status" invisible="state != 'done'">
                        <i class="fa fa-check-circle me-1"/>
                        <span>All messages have been processed. You can close this window.</span>
                    </div>
                    <div invisible="not current_line_id">
                        <div class="alert alert-warning mb-2" role="alert" invisible="current_phone_valid">
                            <i class="fa fa-exclamation-triangle me-1"/>
                            <span>No valid mobile number for this contact: type it below, or skip it.</span>
                        </div>
                        <group>
                            <group>
                                <field name="current_record" readonly="1"/>
                                <field name="current_partner_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="current_phone" placeholder="05XXXXXXXX" class="o_raseel_wa_ltr"/>
                                <field name="current_phone_display" class="fw-bold o_raseel_wa_ltr"
                                       invisible="not current_phone"/>
                            </group>
                        </group>
                        <div class="row">
                            <div class="col-lg-6">
                                <label for="current_body" class="fw-bold"/>
                                <field name="current_body" nolabel="1" class="o_raseel_wa_body"/>
                            </div>
                            <div class="col-lg-6">
                                <label for="current_preview" class="fw-bold"/>
                                <field name="current_preview" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                    </div>
                    <details class="mt-3">
                        <summary class="fw-bold">All messages</summary>
                        <field name="line_ids" nolabel="1" readonly="1">
                            <tree decoration-muted="state == 'skipped'" decoration-success="state == 'sent'"
                                  decoration-danger="not phone_valid and state == 'pending'">
                                <field name="sequence" column_invisible="True"/>
                                <field name="record_name"/>
                                <field name="partner_id"/>
                                <field name="phone_display" class="o_raseel_wa_ltr"/>
                                <field name="phone_valid" column_invisible="True"/>
                                <field name="template_id" optional="show"/>
                                <field name="state" widget="badge" decoration-success="state == 'sent'"
                                       decoration-info="state == 'pending'"/>
                            </tree>
                        </field>
                    </details>
                </div>

                <footer>
                    <button name="action_prepare" type="object" string="Prepare Messages" icon="fa-list-ol"
                            class="btn-primary" invisible="state != 'setup'" data-hotkey="q"/>
                    <button name="action_send_current" type="object" string="Open WhatsApp &amp; Next"
                            icon="fa-whatsapp" class="btn-primary o_raseel_wa_send"
                            invisible="state != 'send' or not current_line_id" data-hotkey="q"/>
                    <button name="action_skip_current" type="object" string="Skip"
                            class="btn-secondary" invisible="state != 'send' or not current_line_id" data-hotkey="s"/>
                    <button name="action_restart_skipped" type="object" string="Back to Skipped"
                            class="btn-secondary" invisible="state == 'setup' or not skipped_count"/>
                    <button name="action_back_to_setup" type="object" string="Change Settings"
                            class="btn-link" invisible="state != 'send' or sent_count"/>
                    <button string="Close" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Menu: payment reminders for overdue invoices -->
    <record id="action_raseel_wa_overdue" model="ir.actions.server">
        <field name="name">Payment Reminders</field>
        <field name="model_id" ref="model_raseel_wa_bulk"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_overdue()</field>
    </record>
</odoo>
