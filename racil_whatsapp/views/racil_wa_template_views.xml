<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="racil_wa_template_view_list" model="ir.ui.view">
        <field name="name">racil.wa.template.list</field>
        <field name="model">racil.wa.template</field>
        <field name="arch" type="xml">
            <tree string="WhatsApp Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="key"/>
                <field name="style"/>
                <field name="model_name" optional="show"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="racil_wa_template_view_form" model="ir.ui.view">
        <field name="name">racil.wa.template.form</field>
        <field name="model">racil.wa.template</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Template">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Invoice ready"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="key"/>
                            <field name="style"/>
                        </group>
                        <group>
                            <field name="model_name" placeholder="account.move"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="body" class="o_racil_wa_body" dir="auto"/>
                    <div class="alert alert-light mt-3 small" role="status">
                        <b>Placeholders</b><br/>
                        {partner} {company} {doc} {amount} {residual} {due_date} {date} {link} {user}<br/>
                        {العميل} {الشركة} {المستند} {المبلغ} {المتبقي} {الاستحقاق} {التاريخ} {الرابط} {الموظف}<br/>
                        <b>WhatsApp formatting</b>: *bold* _italic_ ~strike~
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="racil_wa_template_view_search" model="ir.ui.view">
        <field name="name">racil.wa.template.search</field>
        <field name="model">racil.wa.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="body"/>
                <filter name="f_msa" string="Arabic (formal)" domain="[('style', '=', 'msa')]"/>
                <filter name="f_gulf" string="Arabic (Gulf dialect)" domain="[('style', '=', 'gulf')]"/>
                <filter name="f_en" string="English" domain="[('style', '=', 'en')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="g_key" string="Situation" context="{'group_by': 'key'}"/>
                <filter name="g_style" string="Language Style" context="{'group_by': 'style'}"/>
            </search>
        </field>
    </record>

    <record id="action_racil_wa_template" model="ir.actions.act_window">
        <field name="name">WhatsApp Templates</field>
        <field name="res_model">racil.wa.template</field>
        <field name="view_mode">tree,form</field>
        
    </record>

    <record id="racil_wa_document_view_list" model="ir.ui.view">
        <field name="name">racil.wa.document.list</field>
        <field name="model">racil.wa.document</field>
        <field name="arch" type="xml">
            <tree string="Documents with WhatsApp Button" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_name"/>
                <field name="partner_field" optional="show"/>
                <field name="phone_field" optional="hide"/>
                <field name="is_installed"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="action_racil_wa_document" model="ir.actions.act_window">
        <field name="name">Documents with WhatsApp Button</field>
        <field name="res_model">racil.wa.document</field>
        <field name="view_mode">tree</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a document type</p>
            <p>Any model with a customer field can get the WhatsApp button, including custom models.</p>
        </field>
    </record>

    <menuitem id="menu_racil_wa_root" name="WhatsApp Button" parent="base.menu_administration" sequence="60"/>
    <menuitem id="menu_racil_wa_template" name="Message Templates" parent="menu_racil_wa_root"
              action="action_racil_wa_template" sequence="10"/>
    <menuitem id="menu_racil_wa_document" name="Enabled Documents" parent="menu_racil_wa_root"
              action="action_racil_wa_document" sequence="20"/>
</odoo>
